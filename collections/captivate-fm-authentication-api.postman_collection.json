      "id": "8a04ebe6-5c0f-4ed2-912f-521aa9c8fdd1",
      "name": "Authentication",
      "description": {
        "content": "Exchange a user ID and API token for a Bearer token.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "2fc7a7fb-0cfb-4974-b1be-b802b22f1138",
          "name": "Authenticate User",
          "request": {
            "name": "Authenticate User",
            "description": {
              "content": "All requests must be authenticated using a Bearer token for the user. Obtain the token by sending the user's ID and their API token (both found in the API section of the Captivate account). Returns a Bearer token used in the Authorization header for all other requests.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "authenticate",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "username",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) The Captivate user ID (UUID)."
                },
                {
                  "key": "token",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) The user's API token from their Captivate account."
                }
              ]
            }
          },
          "response": [
            {
              "id": "c05d5561-d336-40e8-af6e-ee26977ace9f",
              "name": "Authentication succeeded; a Bearer token is returned (modeled).",
              "originalRequest": {
                "url": {
                  "path": [
