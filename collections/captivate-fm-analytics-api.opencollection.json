{
  "opencollection": "1.0.0",
  "info": {
    "name": "Captivate Analytics API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Analytics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Overview Analytics for Podcast",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.captivate.fm/insights/:showId/overview",
            "params": [
              {
                "name": "showId",
                "value": "",
                "type": "path",
                "description": "The show ID (UUID) for insights."
              },
              {
                "name": "start",
                "value": "",
                "type": "query"
              },
              {
                "name": "end",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeTopEpisodes",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Overview analytics for a podcast over a date range."
        },
        {
          "info": {
            "name": "Get Overview Analytics for a specific Episode",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.captivate.fm/insights/:showId/overview/:episodeId",
            "params": [
              {
                "name": "showId",
                "value": "",
                "type": "path",
                "description": "The show ID (UUID) for insights."
              },
              {
                "name": "episodeId",
                "value": "",
                "type": "path",
                "description": "The episode ID (UUID) for insights."
              },
              {
                "name": "start",
                "value": "",
                "type": "query"
              },
              {
                "name": "end",
                "value": "",
                "type": "query"
              }
            ]
          },
